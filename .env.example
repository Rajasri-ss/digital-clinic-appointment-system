# ===================================================================
# HealthConnect - Environment Configuration Template
# Copy this file to '.env' and update the values with your local settings.
# Note: '.env' is ignored by Git to protect sensitive credentials.
# ===================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=healthconnect
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Alternatively, configure the full JDBC URL directly:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/healthconnect?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
# Note: Secret key MUST be at least 256 bits (32+ characters) long for HS256 algorithm
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_hs256
JWT_EXPIRATION=86400000

# CORS & Upload Directories
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
UPLOAD_DIR=uploads/records
UPLOAD_PRESCRIPTIONS_DIR=uploads/prescriptions
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# SQL Initialization Mode ('never' for normal operation; 'always' runs schema.sql on startup)
SQL_INIT_MODE=never
