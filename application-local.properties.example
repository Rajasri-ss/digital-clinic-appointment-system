# ===================================================================
# HealthConnect - Local Spring Boot Configuration Template
# Copy this file to 'application-local.properties' in root or src/main/resources/
# and fill in your local database credentials.
# Note: 'application-local.properties' is ignored by Git to protect sensitive credentials.
# ===================================================================

# Database Credentials
spring.datasource.url=jdbc:mysql://localhost:3306/healthconnect?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=your_database_username
spring.datasource.password=your_database_password

# JWT Configuration (Minimum 256 bits / 32+ characters)
jwt.secret=your_jwt_secret_key_minimum_32_characters_long_for_hs256
jwt.expiration=86400000

# Server Port
server.port=8080

# SQL Initialization ('never' for normal operation; 'always' for fresh schema creation)
spring.sql.init.mode=never
