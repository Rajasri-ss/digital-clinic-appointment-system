# ===================================================================
# Git Ignore for HealthConnect (Spring Boot & Frontend)
# ===================================================================

# 1. Environment & Sensitive Credentials
.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-local.yaml
src/main/resources/application-local.properties
src/main/resources/application-local.yml
src/main/resources/application-local.yaml

# 2. Build Outputs & Compiled Classes
target/
build/
dist/
out/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# 3. Logs & Process Artifacts
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*
replay_pid*

# 4. IDEs, Editors & Tool-Generated Caches
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
.apt_generated/
.settings/
.project
.classpath
.factorypath
*.sublime-project
*.sublime-workspace
.kiro/
.github/java-upgrade/

# 5. OS & Filesystem Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 6. Temporary Files & Editor Backups
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig

# 7. Local Database Dumps & Backups
*.sql.bak
backup.sql
*.dump
*.db
*.sqlite
*.sqlite3

# 8. User Uploads & Personal Health Information (PHI)
uploads/records/*
uploads/prescriptions/*
uploads/doctors/*
!uploads/records/.gitkeep
!uploads/prescriptions/.gitkeep
!uploads/doctors/.gitkeep

# 9. Node Modules (if any frontend tooling is added)
node_modules/
